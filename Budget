<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>Budget mensile</title>
<style>
:root{--bg:#1b2029;--card:#252c38;--ink:#e8edf5;--muted:#aeb8c8;--blue:#8ea7ff;--green:#78d6ad;--red:#f28b9c;--line:#3a4555;--shadow:0 8px 24px rgba(5,10,20,.24)}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Inter,Arial,sans-serif;padding-bottom:92px}header{padding:calc(env(safe-area-inset-top) + 18px) 18px 16px;background:linear-gradient(135deg,#536fae,#6d5a9c);color:white;border-radius:0 0 28px 28px}.top{display:flex;align-items:center;justify-content:space-between}.top h1{font-size:25px;margin:0;font-weight:800}.month{margin-top:18px;display:flex;align-items:center;justify-content:space-between}.month button{background:#ffffff25;color:#fff;border:1px solid #ffffff44;border-radius:12px;padding:9px 13px;font-size:18px}.month strong{font-size:18px}.container{max-width:720px;margin:0 auto;padding:0 16px}.summary{margin-top:-10px;position:relative;display:grid;grid-template-columns:1fr 1fr;gap:12px}.card{background:var(--card);border-radius:20px;padding:17px;box-shadow:var(--shadow)}.summary .card:first-child{grid-column:span 2}.label{font-size:12px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.04em}.value{font-size:25px;font-weight:800;margin-top:7px}.positive{color:var(--green)}.negative{color:var(--red)}.section-title{display:flex;justify-content:space-between;align-items:center;margin:25px 2px 11px}.section-title h2{font-size:18px;margin:0}.link{border:0;background:none;color:var(--blue);font-weight:700}.progress{height:9px;background:#343d4b;border-radius:99px;overflow:hidden;margin-top:13px}.progress i{display:block;height:100%;background:linear-gradient(90deg,#3867ff,#7b5cff);border-radius:99px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:11px}.btn{border:0;border-radius:15px;padding:14px 12px;font-weight:750;font-size:14px;background:var(--blue);color:white}.btn.secondary{background:#34415a;color:#b4c3ff}.btn.green{background:#29483f;color:#91e2bd}.category{display:flex;align-items:center;gap:11px;padding:13px 0;border-bottom:1px solid var(--line)}.category:last-child{border-bottom:0}.cat-icon{width:39px;height:39px;display:grid;place-items:center;border-radius:13px;background:#34415a;font-size:20px}.cat-info{flex:1}.cat-info b{display:block;font-size:14px}.cat-info small{color:var(--muted)}.cat-amount{font-weight:800}.empty{text-align:center;padding:24px;color:var(--muted);font-size:14px}.modal{display:none;position:fixed;inset:0;background:#11182766;z-index:3;align-items:flex-end}.modal.open{display:flex}.sheet{background:var(--card);width:100%;max-width:720px;margin:auto 0 0;border-radius:24px 24px 0 0;padding:22px 18px calc(22px + env(safe-area-inset-bottom));max-height:90vh;overflow:auto}.sheet h2{margin:0 0 18px}.field{margin:12px 0}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}.field input,.field select{width:100%;padding:14px;border:1px solid var(--line);border-radius:13px;font-size:16px;background:#303946;color:var(--ink)}.form-actions{display:flex;gap:10px;margin-top:18px}.form-actions button{flex:1}.history-row{display:flex;justify-content:space-between;align-items:center;padding:15px 0;border-bottom:1px solid var(--line)}.history-row:last-child{border-bottom:0}.history-row b{display:block}.history-row small{color:var(--muted)}.pill{padding:6px 9px;background:#f0f3ff;border-radius:10px;color:var(--blue);font-size:12px;font-weight:700}.bottom{position:fixed;bottom:0;left:0;right:0;background:#222a35;border-top:1px solid var(--line);padding:10px 18px calc(10px + env(safe-area-inset-bottom));display:flex;justify-content:space-around;z-index:2}.nav{border:0;background:none;color:var(--muted);font-size:11px;font-weight:700}.nav.active{color:var(--blue)}.nav span{display:block;font-size:22px;margin-bottom:2px}#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#303b4b;color:#fff;padding:11px 15px;border-radius:12px;font-size:13px;display:none;z-index:5}.report{line-height:1.5;color:#aab5c5;font-size:14px}.report b{color:var(--ink)}
</style></head>
<body>
<header><div class="top"><h1>Il mio budget</h1><button class="btn" style="background:#ffffff20;border:1px solid #ffffff55;padding:9px 11px" onclick="openModal('settings')">⚙️</button></div><div class="month"><button onclick="shiftMonth(-1)">‹</button><strong id="monthName"></strong><button onclick="shiftMonth(1)">›</button></div></header>
<main class="container"><section class="summary"><div class="card"><div class="label">Disponibile questo mese</div><div class="value" id="balance">€ 0,00</div><div class="progress"><i id="progress"></i></div><small id="progressText" style="color:var(--muted);display:block;margin-top:8px"></small></div><div class="card"><div class="label">Entrate</div><div class="value positive" id="income">€ 0,00</div></div><div class="card"><div class="label">Spese</div><div class="value negative" id="spent">€ 0,00</div></div></section>
<div class="section-title"><h2>Azioni rapide</h2></div><div class="actions"><button class="btn" onclick="openModal('expense')">＋ Inserisci spesa</button><button class="btn green" onclick="openModal('income')">＋ Aggiungi entrata</button></div>
<div class="section-title"><h2>Spese per categoria</h2><button class="link" onclick="openModal('expense')">Modifica</button></div><section class="card" id="categories"></section>
<div class="section-title"><h2>Movimenti recenti</h2><button class="link" onclick="showTab('history')">Vedi tutti</button></div><section class="card" id="recent"></section>
<section id="history" style="display:none"><div class="section-title"><h2>Storico mensile</h2></div><div class="card" id="historyList"></div><div class="section-title"><h2>Resoconto</h2></div><div class="card report" id="report"></div></section></main>
<nav class="bottom"><button class="nav active" id="homeNav" onclick="showTab('home')"><span>⌂</span>Panoramica</button><button class="nav" id="historyNav" onclick="showTab('history')"><span>▤</span>Storico</button></nav>
<div class="modal" id="expenseModal"><div class="sheet"><h2>Nuova spesa</h2><div class="field"><label>Importo</label><input id="expenseAmount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00"></div><div class="field"><label>Categoria</label><select id="expenseCategory"></select></div><div class="field"><label>Descrizione (facoltativa)</label><input id="expenseNote" placeholder="Es. spesa supermercato"></div><div class="form-actions"><button class="btn secondary" onclick="closeModals()">Annulla</button><button class="btn" onclick="saveExpense()">Salva spesa</button></div></div></div>
<div class="modal" id="incomeModal"><div class="sheet"><h2>Aggiungi entrata</h2><div class="field"><label>Importo</label><input id="incomeAmount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00"></div><div class="field"><label>Tipo</label><select id="incomeType"><option>Stipendio</option><option>Lavoro extra</option><option>Rimborso</option><option>Altro</option></select></div><div class="field"><label>Nota (facoltativa)</label><input id="incomeNote" placeholder="Es. progetto freelance"></div><div class="form-actions"><button class="btn secondary" onclick="closeModals()">Annulla</button><button class="btn green" onclick="saveIncome()">Salva entrata</button></div></div></div>
<div class="modal" id="settingsModal"><div class="sheet"><h2>Impostazioni</h2><p style="color:var(--muted);font-size:14px">I dati restano salvati in questo iPhone/browser tramite memoria locale.</p><div class="form-actions"><button class="btn secondary" onclick="closeModals()">Chiudi</button><button class="btn" onclick="exportData()">Esporta dati</button></div></div></div><div id="toast"></div>
<script>
const cats=[['Casa','🏠'],['Alimentari','🛒'],['Trasporti','🚗'],['Bollette','💡'],['Salute','❤️'],['Svago','🎬'],['Shopping','🛍️'],['Altro','📦']];let selected=new Date();let data=JSON.parse(localStorage.getItem('budgetData')||'{}');const key=()=>selected.getFullYear()+'-'+String(selected.getMonth()+1).padStart(2,'0');const euro=n=>new Intl.NumberFormat('it-IT',{style:'currency',currency:'EUR'}).format(n||0);function monthLabel(){return selected.toLocaleDateString('it-IT',{month:'long',year:'numeric'}).replace(/^./,x=>x.toUpperCase())}function month(){let k=key();if(!data[k])data[k]={salary:0,entries:[],expenses:[]};return data[k]}function save(){localStorage.setItem('budgetData',JSON.stringify(data))}function render(){document.getElementById('monthName').textContent=monthLabel();let m=month(),income=(m.salary||0)+m.entries.reduce((a,x)=>a+x.amount,0),spent=m.expenses.reduce((a,x)=>a+x.amount,0),balance=income-spent;document.getElementById('income').textContent=euro(income);document.getElementById('spent').textContent=euro(spent);document.getElementById('balance').textContent=euro(balance);document.getElementById('balance').className='value '+(balance<0?'negative':'positive');let pct=income?Math.min(100,spent/income*100):0;document.getElementById('progress').style.width=pct+'%';document.getElementById('progressText').textContent=income?`${pct.toFixed(0)}% del budget utilizzato`:'Imposta lo stipendio per iniziare';let totals={};cats.forEach(c=>totals[c[0]]=0);m.expenses.forEach(x=>totals[x.category]=(totals[x.category]||0)+x.amount);document.getElementById('categories').innerHTML=cats.map(c=>`<div class="category"><div class="cat-icon">${c[1]}</div><div class="cat-info"><b>${c[0]}</b><small>${totals[c[0]]?((totals[c[0]]/Math.max(spent,1))*100).toFixed(0)+'% delle spese':'Nessuna spesa'}</small></div><div class="cat-amount">${euro(totals[c[0]])}</div></div>`).join('');let mov=[...m.expenses.map(x=>({...x,kind:'expense'})),...m.entries.map(x=>({...x,kind:'income'}))].sort((a,b)=>b.date-a.date).slice(0,5);document.getElementById('recent').innerHTML=mov.length?mov.map(row).join(''):'<div class="empty">Nessun movimento ancora.<br>Inserisci la prima spesa o entrata.</div>';renderHistory()}function row(x){return `<div class="history-row"><div><b>${x.kind==='expense'?'🔻':'🔺'} ${x.note||x.category||x.type}</b><small>${new Date(x.date).toLocaleDateString('it-IT')}</small></div><strong class="${x.kind==='expense'?'negative':'positive'}">${x.kind==='expense'?'-':'+'}${euro(x.amount)}</strong></div>`}function renderHistory(){let keys=Object.keys(data).sort().reverse();document.getElementById('historyList').innerHTML=keys.length?keys.map(k=>{let m=data[k],sp=m.expenses.reduce((a,x)=>a+x.amount,0),inc=(m.salary||0)+m.entries.reduce((a,x)=>a+x.amount,0);return `<div class="history-row"><div><b>${new Date(k+'-02').toLocaleDateString('it-IT',{month:'long',year:'numeric'})}</b><small>Entrate ${euro(inc)} · Spese ${euro(sp)}</small></div><span class="pill">${euro(inc-sp)}</span></div>`}).join(''):'<div class="empty">Lo storico comparirà qui.</div>';let all=keys.flatMap(k=>data[k].expenses);let total=all.reduce((a,x)=>a+x.amount,0),top={};all.forEach(x=>top[x.category]=(top[x.category]||0)+x.amount);let best=Object.entries(top).sort((a,b)=>b[1]-a[1])[0];document.getElementById('report').innerHTML=keys.length?`Hai registrato <b>${euro(total)}</b> di spese complessive in <b>${keys.length}</b> mes${keys.length===1?'e':'i'}. ${best?`La categoria più utilizzata è <b>${best[0]}</b> (${euro(best[1])}).`:''}`:'Nessun dato sufficiente per il resoconto.'}function openModal(type){document.getElementById(type+'Modal').classList.add('open');if(type==='expense')document.getElementById('expenseCategory').innerHTML=cats.map(c=>`<option>${c[0]}</option>`).join('')}function closeModals(){document.querySelectorAll('.modal').forEach(x=>x.classList.remove('open'))}function saveExpense(){let amount=+document.getElementById('expenseAmount').value;if(!amount)return toast('Inserisci un importo');month().expenses.push({amount,category:document.getElementById('expenseCategory').value,note:document.getElementById('expenseNote').value,date:Date.now()});save();closeModals();render();toast('Spesa salvata')}function saveIncome(){let amount=+document.getElementById('incomeAmount').value;if(!amount)return toast('Inserisci un importo');let m=month(),type=document.getElementById('incomeType').value,note=document.getElementById('incomeNote').value;if(type==='Stipendio'&&!m.salary)m.salary=amount;else m.entries.push({amount,type,note,date:Date.now()});save();closeModals();render();toast('Entrata salvata')}function shiftMonth(n){selected.setMonth(selected.getMonth()+n);render()}function showTab(t){let h=t==='history';document.getElementById('history').style.display=h?'block':'none';document.querySelectorAll('.nav').forEach(x=>x.classList.remove('active'));document.getElementById(h?'historyNav':'homeNav').classList.add('active');window.scrollTo(0,0)}function toast(t){let x=document.getElementById('toast');x.textContent=t;x.style.display='block';setTimeout(()=>x.style.display='none',1800)}function exportData(){let a=document.createElement('a');a.href='data:application/json;charset=utf-8,'+encodeURIComponent(JSON.stringify(data,null,2));a.download='backup-budget.json';a.click();toast('Backup esportato')}render();
</script></body></html>
